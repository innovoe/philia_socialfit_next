# SocialFit member FE — copy to .env and edit
# Client-visible (NEXT_PUBLIC_*) because the browser talks to Django directly.

# Local (nginx → Django philia-dev)
NEXT_PUBLIC_PHILIA_API_BASE=http://localhost:8123/api/socialfit
NEXT_PUBLIC_PHILIA_AUTH_BASE=http://localhost:8123/api

# Server alternatives (uncomment one pair):
# NEXT_PUBLIC_PHILIA_API_BASE=http://103.180.245.81:8123/api/socialfit
# NEXT_PUBLIC_PHILIA_AUTH_BASE=http://103.180.245.81:8123/api
# NEXT_PUBLIC_PHILIA_API_BASE=http://89.116.29.166:8123/api/socialfit
# NEXT_PUBLIC_PHILIA_AUTH_BASE=http://89.116.29.166:8123/api
# NEXT_PUBLIC_PHILIA_API_BASE=https://api.philia.life/api/socialfit
# NEXT_PUBLIC_PHILIA_AUTH_BASE=https://api.philia.life/api

# true = offline mocks; false = hit real BE
NEXT_PUBLIC_PHILIA_USE_MOCKS=false
